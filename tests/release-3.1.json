        {
          "op": "replace",
          "path": "/request/revocation/revoked_at",
          "value": "2026-04-28T17:14:23Z"
        },
        {
          "op": "replace",
          "path": "/request/terminal_at",
          "value": "2026-04-28T17:14:23Z"
        }
      ]
    },
    {
      "name": "consumed request carries a revocation",
      "schema": "schemas/approval-request.schema.json",
      "instance": "examples/approval-request.json",
      "expect": "schema",
      "operations": [
        {
          "op": "add",
          "path": "/revocation",
          "value": {
            "revoked_at": "2026-04-28T09:14:34Z",
            "revoked_by": {
              "kind": "human",
              "identifier": "rene@acme-corp.example",
              "authentication": {
                "method": "signed_callback",
                "human_present": true,
                "assurance": "substantial"
              }
            },
            "reason_code": "approver_withdrew"
          }
        }
      ]
    },
    {
      "name": "agent feedback asks to change a field outside the payload",
      "schema": "schemas/approval-envelope.schema.json",
      "instance": "examples/rejected-envelope.json",
      "expect": "schema",
      "operations": [
        {
          "op": "replace",
          "path": "/resolutions/0/agent_feedback/requested_changes/0/path",
          "value": "/tenant"
        }
      ]
    },
    {
      "name": "agent feedback on an approval",
      "schema": "schemas/resolution-record.schema.json",
