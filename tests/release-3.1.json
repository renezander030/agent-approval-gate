      "expect": "schema",
      "operations": [
        {
          "op": "add",
          "path": "/agent_feedback",
          "value": {
            "reason_code": "other",
            "message": "Fine"
          }
        }
      ]
    },
    {
      "name": "elicitation rejection by a client without a present human",
