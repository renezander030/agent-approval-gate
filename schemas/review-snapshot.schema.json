{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v2.0.0/schemas/review-snapshot.schema.json",
  "title": "ReviewSnapshot",
  "description": "The exact decision material presented to an approver, bound to the effective action and payload by canonical hashes.",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "proposal_id",
    "action_hash",
    "payload_hash",
    "content_hash",
    "rendered_at",
    "renderer",
    "locale",
    "content"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "snapshot_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "action_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "payload_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "content_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "rendered_at": {"type": "string", "format": "date-time"},
    "renderer": {
      "type": "object",
      "required": ["name", "version", "format"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "format": {"type": "string", "enum": ["json", "text", "html", "native"]}
      }
    },
    "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "content": {
      "type": "object",
      "required": [
        "action_type",
        "action_identity",
        "target",
        "arguments",
        "risk",
        "expires_at",
        "policy_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
        },
        "action_identity": {
          "type": "object",
          "required": ["proposal_id", "call_id", "agent_identity"],
          "additionalProperties": false,
          "properties": {
            "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "call_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "agent_identity": {"$ref": "common.schema.json#/$defs/identifier"}
          }
        },
        "target": true,
        "arguments": true,
        "risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "expires_at": {"type": "string", "format": "date-time"},
        "policy_summary": {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 1000},
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "common.schema.json#/$defs/evidence_reference"}
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "common.schema.json#/$defs/safe_text"}
        }
      }
    }
  }
}
