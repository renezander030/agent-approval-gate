{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v3.3.0/schemas/approval-request.schema.json",
  "title": "ApprovalRequest",
  "description": "Durable state for one pending approval. Resolve it by request_id with compare-and-set semantics; never infer authority from payload shape or conversation text.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "proposal_id",
    "call_id",
    "tenant",
    "action_hash",
    "validation_id",
    "review_snapshot_id",
    "callback_nonce_hash",
    "requested_at",
    "expires_at",
    "status",
    "revision",
    "requested_by",
    "policy",
    "channels"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "call_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "parent_call_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 64},
    "action_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "validation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "review_snapshot_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "callback_nonce_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "expired", "cancelled", "failed", "consumed", "revoked"]
    },
    "revision": {"type": "integer", "minimum": 1},
    "requested_by": {"$ref": "common.schema.json#/$defs/actor"},
    "policy": {"$ref": "approval-policy.schema.json"},
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["channel", "target_hash", "delivery_status"],
        "additionalProperties": false,
        "properties": {
          "channel": {"type": "string", "$ref": "common.schema.json#/$defs/channel"},
          "target_hash": {"$ref": "common.schema.json#/$defs/digest"},
          "delivery_status": {
            "type": "string",
            "enum": ["pending", "sent", "delivered", "failed"]
          },
          "notification_id": {"type": "string", "maxLength": 256},
          "sent_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "review_evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "common.schema.json#/$defs/evidence_reference"}
    },
    "relay": {
      "description": "Ancestor calls that carried this request's review up the delegation chain to the human, nearest first. A relay forwards the review; the decision stays with the approver and binds the delegated call's exact action.",
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["call_id", "agent_identity", "relayed_at"],
        "additionalProperties": false,
        "properties": {
          "call_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "agent_identity": {"$ref": "common.schema.json#/$defs/identifier"},
          "relayed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "escalations": {
      "description": "Notices sent under the policy's escalation while the request was pending, in time order.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["escalated_at", "notified_actor_ids", "channel"],
        "additionalProperties": false,
        "properties": {
          "escalated_at": {"type": "string", "format": "date-time"},
          "notified_actor_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 128}
          },
          "channel": {"type": "string", "$ref": "common.schema.json#/$defs/prompt_channel"}
        }
      }
    },
    "policy_refusal": {
      "description": "What the proposing agent and its user are told when the policy denies the request: the evaluation and rules that decided, who owns the policy, and the next step. It never reopens the request.",
      "type": "object",
      "required": ["evaluation_id", "reason_code", "message", "policy_owner", "next_step"],
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "reason_code": {"type": "string", "enum": ["denied_by_rule", "no_matching_rule", "evaluator_unavailable"]},
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        },
        "message": {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 1000},
        "policy_owner": {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 128},
        "next_step": {"type": "string", "enum": ["revise_and_resubmit", "contact_policy_owner", "do_not_retry"]}
      }
    },
    "trace_context": {"$ref": "common.schema.json#/$defs/trace_context"},
    "terminal_at": {"type": "string", "format": "date-time"},
    "decision_record_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "dispatch_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "terminal_reason": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "deadline_elapsed",
        "cancelled_by_requester",
        "callback_invalid",
        "policy_failed",
        "delivery_failed",
        "consumed_for_dispatch",
        "approval_revoked",
        "superseded"
      ]
    },
    "superseded_by": {
      "description": "The newer request that replaced this pending one. A decision on a superseded request is refused; the reviewer acts on the successor.",
      "type": "object",
      "required": ["request_id", "proposal_id"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"}
      }
    },
    "revocation": {
      "description": "Withdrawal of an approved, unconsumed request. A conditional transition from approved to revoked must fail when the request was already consumed.",
      "type": "object",
      "required": ["revoked_at", "revoked_by", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "revoked_at": {"type": "string", "format": "date-time"},
        "revoked_by": {"$ref": "common.schema.json#/$defs/actor"},
        "reason_code": {
          "type": "string",
          "enum": [
            "approver_withdrew",
            "authority_changed",
            "policy_changed",
            "target_changed",
            "superseded",
            "security_hold"
          ]
        },
        "safe_detail": {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 500}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_reason": {"const": "superseded"}}, "required": ["terminal_reason"]},
      "then": {"required": ["superseded_by"]},
      "else": {"not": {"required": ["superseded_by"]}}
    },
    {
      "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["terminal_at"]},
            {"required": ["terminal_reason"]},
            {"required": ["decision_record_id"]},
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "required": ["terminal_at", "terminal_reason", "decision_record_id"],
        "properties": {"terminal_reason": {"const": "approved"}},
        "not": {
          "anyOf": [
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]},
      "then": {
        "required": ["terminal_at", "terminal_reason", "decision_record_id"],
        "properties": {"terminal_reason": {"const": "rejected"}},
        "not": {
          "anyOf": [
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "expired"}},
        "required": ["status"]
      },
      "then": {
        "required": ["terminal_at", "terminal_reason"],
        "properties": {"terminal_reason": {"const": "deadline_elapsed"}},
        "not": {
          "anyOf": [
            {"required": ["decision_record_id"]},
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}, "required": ["status"]},
      "then": {
        "required": ["terminal_at", "terminal_reason"],
        "properties": {"terminal_reason": {"enum": ["cancelled_by_requester", "superseded"]}},
        "not": {
          "anyOf": [
            {"required": ["decision_record_id"]},
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {
        "required": ["terminal_at", "terminal_reason"],
        "properties": {
          "terminal_reason": {
            "enum": ["callback_invalid", "policy_failed", "delivery_failed"]
          }
        },
        "not": {
          "anyOf": [
            {"required": ["decision_record_id"]},
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
      "then": {
        "required": ["terminal_at", "terminal_reason", "decision_record_id", "revocation"],
        "properties": {"terminal_reason": {"const": "approval_revoked"}},
        "not": {
          "anyOf": [
            {"required": ["consumed_at"]},
            {"required": ["dispatch_id"]}
          ]
        }
      },
      "else": {"not": {"required": ["revocation"]}}
    },
    {
      "if": {"properties": {"status": {"const": "consumed"}}, "required": ["status"]},
      "then": {
        "required": [
          "terminal_at",
          "terminal_reason",
          "decision_record_id",
          "consumed_at",
          "dispatch_id"
        ],
        "properties": {"terminal_reason": {"const": "consumed_for_dispatch"}}
      }
    }
  ]
}
