{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v1.0.0/schemas/approval-policy.schema.json",
  "title": "ApprovalPolicySnapshot",
  "description": "Immutable evidence of the policy revision and material inputs that selected an approval path.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "policy_digest",
    "evaluation_id",
    "material_input_hash",
    "evaluated_at",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "policy_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "evaluation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "material_input_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "object",
      "required": [
        "minimum_approvals",
        "distinct_approvers",
        "human_only",
        "allowed_channels",
        "allow_auto_approval"
      ],
      "additionalProperties": false,
      "properties": {
        "minimum_approvals": {"type": "integer", "minimum": 1, "maximum": 16},
        "distinct_approvers": {"type": "boolean"},
        "human_only": {"type": "boolean"},
        "allowed_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["telegram", "slack", "email", "web", "n8n_form", "policy"]
          }
        },
        "signature_required_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["telegram", "slack", "email", "web", "n8n_form", "policy"]
          }
        },
        "allow_auto_approval": {"type": "boolean"},
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    }
  }
}
