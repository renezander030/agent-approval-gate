{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v3.4.0/schemas/approval-record.schema.json",
  "title": "ApprovalRecord",
  "description": "An append-only terminal decision bound to the exact effective action and payload reviewed by the approver.",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "request_id",
    "proposal_id",
    "request_revision",
    "action_hash",
    "payload_hash",
    "review_snapshot_id",
    "review_content_hash",
    "decision",
    "decided_by",
    "decided_at",
    "recorded_at",
    "channel",
    "policy_evaluation_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "approval_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "request_revision": {"type": "integer", "minimum": 1},
    "action_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "payload_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "review_snapshot_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "review_content_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "expired", "cancelled", "auto_approved", "failed"]
    },
    "decided_by": {"$ref": "common.schema.json#/$defs/actor"},
    "decided_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "channel": {"type": "string", "$ref": "common.schema.json#/$defs/channel"},
    "comment": {"type": "string", "maxLength": 2000},
    "modifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "common.schema.json#/$defs/action_patch_operation"}
    },
    "policy_evaluation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "common.schema.json#/$defs/signature"}
    },
    "standing_grant": {
      "description": "A human's earlier decision to let policy approve a bounded class of actions. An auto approval that cites it names the use it consumes.",
      "type": "object",
      "required": ["grant_id", "granted_by", "granted_at", "expires_at", "scope", "max_uses", "use_number"],
      "additionalProperties": false,
      "properties": {
        "grant_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "granted_by": {
          "allOf": [{"$ref": "common.schema.json#/$defs/actor"}],
          "properties": {
            "kind": {"const": "human"},
            "authentication": {"properties": {"human_present": {"const": true}}}
          }
        },
        "granted_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "scope": {
          "type": "object",
          "required": ["tenant", "action_types", "max_risk"],
          "additionalProperties": false,
          "properties": {
            "tenant": {"type": "string", "minLength": 1, "maxLength": 64},
            "action_types": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}
            },
            "max_risk": {"type": "string", "enum": ["low", "medium", "high"]}
          }
        },
        "max_uses": {"type": "integer", "minimum": 1, "maximum": 10000},
        "use_number": {"type": "integer", "minimum": 1, "maximum": 10000},
        "origin": {
          "description": "The human approval that issued this grant.",
          "type": "object",
          "required": ["request_id", "approval_id"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "approval_id": {"$ref": "common.schema.json#/$defs/identifier"}
          }
        }
      }
    },
    "issued_grant": {
      "description": "A standing grant this human approval explicitly issued in addition to approving its own action. Its granting human is the approver; without it, an approval covers its own action only.",
      "type": "object",
      "required": ["grant_id", "granted_at", "expires_at", "scope", "max_uses"],
      "additionalProperties": false,
      "properties": {
        "grant_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "granted_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "scope": {"$ref": "#/properties/standing_grant/properties/scope"},
        "max_uses": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "rejection_settlement": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["verified_clean", "compensated", "unresolved"]
        },
        "verified_by": {"$ref": "common.schema.json#/$defs/actor"},
        "verified_at": {"type": "string", "format": "date-time"},
        "compensating_action_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "evidence": {"$ref": "common.schema.json#/$defs/evidence_reference"},
        "note": {"type": "string", "maxLength": 2000}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "verified_clean"}}, "required": ["state"]},
          "then": {
            "required": ["verified_by", "verified_at", "evidence"],
            "not": {"required": ["compensating_action_id"]}
          }
        },
        {
          "if": {"properties": {"state": {"const": "compensated"}}, "required": ["state"]},
          "then": {
            "required": [
              "verified_by",
              "verified_at",
              "compensating_action_id",
              "evidence"
            ]
          }
        },
        {
          "if": {"properties": {"state": {"const": "unresolved"}}, "required": ["state"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["verified_by"]},
                {"required": ["verified_at"]},
                {"required": ["compensating_action_id"]},
                {"required": ["evidence"]}
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"required": ["standing_grant"]},
      "then": {"properties": {"decision": {"const": "auto_approved"}}}
    },
    {
      "if": {
        "properties": {
          "decided_by": {
            "properties": {"kind": {"const": "human"}},
            "required": ["kind"]
          }
        },
        "required": ["decided_by"]
      },
      "then": {
        "properties": {
          "decided_by": {
            "properties": {
              "authentication": {
                "properties": {"human_present": {"const": true}},
                "required": ["human_present"]
              }
            },
            "required": ["authentication"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decided_by": {
            "properties": {"kind": {"const": "policy"}},
            "required": ["kind"]
          }
        },
        "required": ["decided_by"]
      },
      "then": {
        "properties": {
          "decided_by": {
            "properties": {
              "authentication": {
                "properties": {
                  "method": {"const": "policy_engine"},
                  "human_present": {"const": false}
                },
                "required": ["method", "human_present"]
              }
            },
            "required": ["authentication"]
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "approved"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "decided_by": {
            "properties": {
              "kind": {"const": "human"},
              "authentication": {
                "properties": {"human_present": {"const": true}},
                "required": ["human_present"]
              }
            },
            "required": ["authentication"]
          },
          "channel": {"$ref": "common.schema.json#/$defs/prompt_channel"}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "auto_approved"}},
        "required": ["decision"]
      },
      "then": {
        "required": ["policy_evaluation_id"],
        "properties": {
          "decided_by": {
            "properties": {"kind": {"const": "policy"}}
          },
          "channel": {"const": "policy"}
        },
        "not": {"required": ["modifications"]}
      }
    },
    {
      "if": {
        "properties": {"decision": {"enum": ["rejected", "expired"]}},
        "required": ["decision"]
      },
      "then": {"required": ["rejection_settlement"]}
    },
    {
      "if": {
        "properties": {
          "decision": {"enum": ["approved", "auto_approved", "cancelled", "failed"]}
        },
        "required": ["decision"]
      },
      "then": {"not": {"required": ["rejection_settlement"]}}
    },
    {
      "if": {"required": ["modifications"]},
      "then": {"properties": {"decision": {"const": "approved"}}}
    },
    {
      "if": {
        "properties": {
          "channel": {"enum": ["mcp_elicitation", "teams", "cli"]},
          "decision": {"enum": ["approved", "rejected"]}
        },
        "required": ["channel", "decision"]
      },
      "then": {
        "properties": {
          "decided_by": {
            "properties": {
              "kind": {"const": "human"},
              "authentication": {
                "properties": {
                  "method": {"enum": ["authenticated_session", "channel_identity", "signed_callback"]},
                  "human_present": {"const": true}
                },
                "required": ["method", "human_present"]
              }
            },
            "required": ["kind", "authentication"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signatures": {
            "contains": {
              "properties": {"algorithm": {"const": "webauthn-es256"}},
              "required": ["algorithm"]
            }
          }
        },
        "required": ["signatures"]
      },
      "then": {
        "properties": {
          "channel": {"const": "web"},
          "decided_by": {
            "properties": {
              "kind": {"const": "human"},
              "authentication": {
                "properties": {
                  "method": {"const": "authenticated_session"},
                  "human_present": {"const": true},
                  "assurance": {"const": "high"}
                },
                "required": ["method", "human_present", "assurance"]
              }
            },
            "required": ["kind", "authentication"]
          }
        }
      }
    }
  ]
}
