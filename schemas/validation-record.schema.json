{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v3.0.0/schemas/validation-record.schema.json",
  "title": "ValidationRecord",
  "description": "Immutable pre-admission evidence that an exact proposed action passed structural, payload, semantic, policy-input, and authorization-input checks before a human was notified.",
  "type": "object",
  "required": [
    "schema_version",
    "validation_id",
    "proposal_id",
    "action_hash",
    "validator",
    "validated_at",
    "outcome",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "validation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "action_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "validator": {"$ref": "common.schema.json#/$defs/actor"},
    "validated_at": {"type": "string", "format": "date-time"},
    "outcome": {"type": "string", "enum": ["passed", "rejected", "failed"]},
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "proposal_schema",
              "payload_schema",
              "semantic_preconditions",
              "policy_inputs",
              "authorization_inputs",
              "custom"
            ]
          },
          "status": {"type": "string", "enum": ["passed", "failed"]},
          "artifact_hash": {"$ref": "common.schema.json#/$defs/digest"},
          "failure": {"$ref": "common.schema.json#/$defs/failure"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
            "then": {"required": ["failure"]}
          },
          {
            "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
            "then": {"not": {"required": ["failure"]}}
          }
        ]
      }
    },
    "failure": {"$ref": "common.schema.json#/$defs/failure"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]},
      "then": {"not": {"required": ["failure"]}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["rejected", "failed"]}}, "required": ["outcome"]},
      "then": {"required": ["failure"]}
    }
  ]
}
