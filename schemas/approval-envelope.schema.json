{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v3.0.0/schemas/approval-envelope.schema.json",
  "title": "ApprovalEnvelope",
  "description": "A complete portable lifecycle bundle. JSON Schema checks structure; scripts/validate_contracts.py also checks cross-record identity, hashes, quorum, time, sequence, and attempt invariants.",
  "type": "object",
  "required": [
    "schema_version",
    "captured_at",
    "proposal",
    "validations",
    "review_snapshots",
    "request",
    "approvals",
    "resolutions",
    "authority_snapshots",
    "dispatches",
    "audit_events",
    "audit_snapshot"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "captured_at": {"type": "string", "format": "date-time"},
    "proposal": {"$ref": "proposed-action.schema.json"},
    "validations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "validation-record.schema.json"}
    },
    "review_snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "review-snapshot.schema.json"}
    },
    "request": {"$ref": "approval-request.schema.json"},
    "approvals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {"$ref": "approval-record.schema.json"}
    },
    "resolutions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {"$ref": "resolution-record.schema.json"}
    },
    "authority_snapshots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {"$ref": "authority-snapshot.schema.json"}
    },
    "dispatches": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {"$ref": "dispatch-record.schema.json"}
    },
    "audit_events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10000,
      "items": {"$ref": "audit-event.schema.json"}
    },
    "audit_snapshot": {"$ref": "audit-snapshot.schema.json"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposal": {
            "properties": {"risk": {"const": "high"}},
            "required": ["risk"]
          }
        },
        "required": ["proposal"]
      },
      "then": {
        "properties": {
          "approvals": {
            "items": {
              "if": {
                "properties": {
                  "decision": {"const": "approved"},
                  "channel": {"enum": ["telegram", "email"]}
                },
                "required": ["decision", "channel"]
              },
              "then": {"required": ["signatures"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "policy": {
                "properties": {
                  "requirements": {
                    "properties": {"human_only": {"const": true}},
                    "required": ["human_only"]
                  }
                },
                "required": ["requirements"]
              }
            },
            "required": ["policy"]
          }
        },
        "required": ["request"]
      },
      "then": {
        "properties": {
          "approvals": {
            "items": {
              "properties": {
                "decision": {"not": {"const": "auto_approved"}}
              }
            }
          }
        }
      }
    }
  ]
}
