{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v3.1.0/schemas/audit-event.schema.json",
  "title": "ApprovalAuditEvent",
  "description": "A redacted, append-only lifecycle event. event_hash is the RFC 8785 SHA-256 digest of this document with event_hash omitted; previous_event_hash links the stream.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "stream_id",
    "sequence",
    "previous_event_hash",
    "event_hash",
    "event_type",
    "occurred_at",
    "recorded_at",
    "tenant",
    "proposal_id",
    "actor",
    "classification",
    "retention",
    "references",
    "detail"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "event_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "stream_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_hash": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/digest"}
      ]
    },
    "event_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "event_type": {
      "type": "string",
      "enum": [
        "proposal.received",
        "validation.passed",
        "validation.rejected",
        "review.presented",
        "approval.requested",
        "approval.notified",
        "approval.viewed",
        "approval.decided",
        "approval.expired",
        "approval.cancelled",
        "approval.revoked",
        "resolution.emitted",
        "resolution.acknowledged",
        "authority.checked",
        "dispatch.started",
        "dispatch.succeeded",
        "dispatch.failed",
        "dispatch.outcome_unknown",
        "dispatch.reconciled",
        "dispatch.not_dispatched",
        "audit.snapshotted"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 64},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "actor": {"$ref": "common.schema.json#/$defs/actor"},
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "retention": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": false,
      "properties": {
        "class": {"type": "string", "enum": ["transient", "standard", "regulated"]},
        "delete_after": {"type": "string", "format": "date-time"},
        "legal_hold": {"type": "boolean"}
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "review_snapshot_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "request_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "approval_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "resolution_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "authority_snapshot_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "dispatch_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "audit_snapshot_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "policy_evaluation_id": {"$ref": "common.schema.json#/$defs/identifier"}
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "expired", "cancelled", "auto_approved", "failed"]
        },
        "channel": {
          "type": "string",
          "enum": ["telegram", "slack", "email", "web", "n8n_form", "mcp_elicitation", "policy"]
        },
        "action_hash": {"$ref": "common.schema.json#/$defs/digest"},
        "payload_hash": {"$ref": "common.schema.json#/$defs/digest"},
        "review_content_hash": {"$ref": "common.schema.json#/$defs/digest"},
        "policy_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "wait_ms": {"type": "integer", "minimum": 0},
        "attempt": {"type": "integer", "minimum": 1},
        "provider_result_hash": {"$ref": "common.schema.json#/$defs/digest"},
        "metadata": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "additionalProperties": {
            "oneOf": [
              {"$ref": "common.schema.json#/$defs/safe_text", "maxLength": 256},
              {"type": ["number", "integer", "boolean", "null"]}
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"previous_event_hash": {"type": "null"}}}
    },
    {
      "if": {"properties": {"sequence": {"minimum": 2}}, "required": ["sequence"]},
      "then": {"properties": {"previous_event_hash": {"$ref": "common.schema.json#/$defs/digest"}}}
    }
  ]
}
