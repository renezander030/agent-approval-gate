{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v3.4.0/schemas/common.schema.json",
  "title": "Agent Approval Gate common definitions",
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "3.4.0"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{7,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base64url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "agent_identity": {
      "type": "object",
      "required": ["identity", "name", "version", "run_id"],
      "additionalProperties": false,
      "properties": {
        "identity": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/safe_text", "maxLength": 64},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$"},
        "model": {"$ref": "#/$defs/safe_text", "maxLength": 128},
        "run_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "actor": {
      "type": "object",
      "required": ["kind", "identifier", "authentication"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["human", "policy", "system", "probe"]
        },
        "identifier": {"$ref": "#/$defs/safe_text", "maxLength": 128},
        "display_name": {"$ref": "#/$defs/safe_text", "maxLength": 128},
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_text", "maxLength": 64}
        },
        "authentication": {
          "type": "object",
          "required": ["method", "human_present", "assurance"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "authenticated_session",
                "signed_callback",
                "channel_identity",
                "policy_engine",
                "service_identity",
                "unknown"
              ]
            },
            "human_present": {"type": "boolean"},
            "assurance": {
              "type": "string",
              "enum": ["low", "substantial", "high"]
            },
            "authenticated_at": {"type": "string", "format": "date-time"},
            "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["hmac-sha256", "ed25519", "webauthn-es256", "pp-receipt-ed25519"]
        },
        "key_id": {"type": "string", "minLength": 1, "maxLength": 1366},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,}$"},
        "signed_object_hash": {"$ref": "#/$defs/digest"},
        "webauthn": {
          "type": "object",
          "required": [
            "credential_id",
            "credential_public_key",
            "public_key_format",
            "authenticator_data",
            "client_data_json",
            "rp_id",
            "origin",
            "user_verification",
            "previous_sign_count",
            "sign_count",
            "registration_evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "credential_id": {"$ref": "#/$defs/base64url", "maxLength": 1366},
            "credential_public_key": {"$ref": "#/$defs/base64url"},
            "public_key_format": {"const": "spki-der"},
            "authenticator_data": {"$ref": "#/$defs/base64url"},
            "client_data_json": {"$ref": "#/$defs/base64url"},
            "rp_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
            },
            "origin": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "user_verification": {"const": "required"},
            "previous_sign_count": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "sign_count": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "registration_evidence": {
              "$ref": "#/$defs/evidence_reference",
              "properties": {"kind": {"const": "webauthn_registration"}}
            }
          }
        },
        "permission_protocol": {
          "type": "object",
          "required": [
            "receipt_id",
            "issuer",
            "canonicalization",
            "payload_bytes",
            "signed_payload_hash",
            "issuer_public_key",
            "key_evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "issuer": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "canonicalization": {"const": "jcs_v2"},
            "payload_bytes": {"$ref": "#/$defs/base64url"},
            "signed_payload_hash": {"$ref": "#/$defs/digest"},
            "issuer_public_key": {"$ref": "#/$defs/base64url", "minLength": 43, "maxLength": 43},
            "key_evidence": {
              "$ref": "#/$defs/evidence_reference",
              "properties": {"kind": {"const": "permission_protocol_key"}}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"algorithm": {"const": "webauthn-es256"}},
            "required": ["algorithm"]
          },
          "then": {
            "required": ["signed_object_hash", "webauthn"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["signed_object_hash"]},
                {"required": ["webauthn"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"algorithm": {"const": "pp-receipt-ed25519"}},
            "required": ["algorithm"]
          },
          "then": {"required": ["permission_protocol"]},
          "else": {"not": {"required": ["permission_protocol"]}}
        }
      ]
    },
    "failure": {
      "type": "object",
      "required": ["class", "code", "retryable"],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "security_refusal",
            "validation_failure",
            "authorization_failure",
            "conflict",
            "transient",
            "unavailable",
            "provider_failure",
            "unknown"
          ]
        },
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "retryable": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/evidence_reference"},
        "safe_detail": {"$ref": "#/$defs/safe_text"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "enum": [
                  "security_refusal",
                  "validation_failure",
                  "authorization_failure",
                  "conflict"
                ]
              }
            },
            "required": ["class"]
          },
          "then": {"properties": {"retryable": {"const": false}}}
        }
      ]
    },
    "action_patch_operation": {
      "type": "object",
      "required": ["op", "path"],
      "additionalProperties": false,
      "properties": {
        "op": {"type": "string", "enum": ["add", "remove", "replace", "test"]},
        "path": {"type": "string", "pattern": "^/payload(?:/.*)?$"},
        "value": true
      },
      "allOf": [
        {
          "if": {
            "properties": {"op": {"enum": ["add", "replace", "test"]}},
            "required": ["op"]
          },
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"op": {"const": "remove"}}, "required": ["op"]},
          "then": {"not": {"required": ["value"]}}
        }
      ]
    },
    "effect_hints": {
      "description": "What the action does to the world, as MCP tool annotations describe it. A hint that is not declared takes the conservative value: not read-only, destructive, not idempotent, open-world.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "read_only": {"type": "boolean"},
        "destructive": {"type": "boolean"},
        "idempotent": {"type": "boolean"},
        "open_world": {"type": "boolean"}
      },
      "not": {
        "properties": {"read_only": {"const": true}, "destructive": {"const": true}},
        "required": ["read_only", "destructive"]
      }
    },
    "target_precondition": {
      "description": "The state of the target the approver saw, checked by the dispatcher immediately before invocation, as HTTP If-Match does.",
      "type": "object",
      "required": ["resource", "kind", "expected"],
      "additionalProperties": false,
      "properties": {
        "resource": {"$ref": "#/$defs/safe_text", "maxLength": 512},
        "kind": {"type": "string", "enum": ["version", "etag", "content_digest"]},
        "expected": {"$ref": "#/$defs/safe_text", "maxLength": 256}
      }
    },
    "channel": {
      "description": "Where a decision was requested or made. policy is the automatic path; every other value is a channel a human answers on.",
      "enum": ["telegram", "slack", "email", "web", "n8n_form", "mcp_elicitation", "teams", "cli", "policy"]
    },
    "prompt_channel": {
      "description": "A channel a human answers on: every channel except policy.",
      "enum": ["telegram", "slack", "email", "web", "n8n_form", "mcp_elicitation", "teams", "cli"]
    },
    "trace_context": {
      "description": "W3C Trace Context of the agent run, so approval records join its distributed trace. It is correlation data, not evidence of authority.",
      "type": "object",
      "required": ["traceparent"],
      "additionalProperties": false,
      "properties": {
        "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
        "tracestate": {"type": "string", "maxLength": 512, "pattern": "^[\\x20-\\x7E]*$"}
      }
    },
    "evidence_reference": {
      "type": "object",
      "required": ["kind", "uri", "digest"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "document",
            "preview",
            "policy",
            "provider_record",
            "reconciliation",
            "permission_protocol_key",
            "webauthn_registration"
          ]
        },
        "uri": {"type": "string", "format": "uri", "maxLength": 2048},
        "digest": {"$ref": "#/$defs/digest"},
        "label": {"$ref": "#/$defs/safe_text", "maxLength": 128}
      }
    }
  }
}
