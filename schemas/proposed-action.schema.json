{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/renezander030/agent-approval-gate/v1.0.0/schemas/proposed-action.schema.json",
  "title": "ProposedAction",
  "description": "An immutable, serializable action draft. The RFC 8785 SHA-256 digest of this complete document is the action_hash carried through approval and dispatch.",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "call_id",
    "agent",
    "action_type",
    "payload_schema",
    "payload",
    "created_at",
    "expires_at",
    "tenant",
    "risk",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "call_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "parent_call_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "agent": {
      "type": "object",
      "required": ["name", "version", "run_id"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 32},
        "model": {"type": "string", "maxLength": 128},
        "run_id": {"$ref": "common.schema.json#/$defs/identifier"}
      }
    },
    "action_type": {
      "type": "string",
      "enum": [
        "email.send",
        "crm.update_record",
        "ticket.create",
        "db.update_row",
        "api.call",
        "n8n.trigger_workflow"
      ]
    },
    "payload_schema": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "format": "uri", "maxLength": 2048},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "payload": {"type": "object"},
    "rationale": {"type": "string", "maxLength": 4000},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 64},
    "risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "idempotency_key": {"$ref": "common.schema.json#/$defs/identifier"},
    "review_evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "common.schema.json#/$defs/evidence_reference"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"action_type": {"const": "email.send"}},
        "required": ["action_type"]
      },
      "then": {
        "properties": {"payload": {"$ref": "actions/email.send.schema.json"}}
      }
    }
  ]
}
